# --- Virtual environment ---------------------------------------------------
# Rebuilt exactly from uv.lock with `uv sync`. Contains absolute paths and
# platform-specific binaries, so a committed copy is useless on any other
# machine. uv.lock IS committed; .venv never is.
.venv/

# --- Python bytecode and tool caches --------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Secrets -------------------------------------------------------------
# Streamlit puts API keys / credentials here. config.toml IS committed.
.streamlit/secrets.toml
.env
.env.*

# --- OS / editor cruft --------------------------------------------------
.DS_Store
Thumbs.db

# --- Local scratch ----------------------------------------------------
# Baseline snapshot taken before the 300k sweep, kept only for the
# reporting-phase comparison. Not part of the deliverable.
results/_baseline_60k/
# Superseded models/figures (the 60k td3_seed0 is in git history) and raw
# training logs.
results/_archive/
results/logs/

# --- TensorBoard event logs ------------------------------------------
# Append-only binary, grows every run, fully regenerated by training.
# The trained models, vecnormalize.pkl and figures under results/ are
# still tracked; only the raw TB stream is ignored.
results/**/tb/
*.tfevents.*
